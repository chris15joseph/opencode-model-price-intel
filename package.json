{
  "name": "opencode-model-price-intel",
  "version": "1.0.0",
  "description": "OpenCode 2 plugin that adds input/output/cache prices and Artificial Analysis Intelligence Index scores to /models, plus a full /model-pricing TUI dialog.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./rpc": "./src/rpc.ts",
    "./tui": "./src/tui.tsx"
  },
  "types": "./src/index.ts",
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@opencode/plugin": "2.2.5"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.6.6",
    "@opentui/solid": ">=0.6.6",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opentui/core": "^0.8.3",
    "@opentui/solid": "^0.8.3",
    "@types/node": "22.20.5",
    "solid-js": "^1.9.18",
    "typescript": "5.9.3"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import ./scripts/register-ts.mjs --test test/*.test.ts",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chris15joseph/opencode-model-price-intel.git"
  },
  "author": "Christopher Joseph <chrisjoseph15496@gmail.com>",
  "homepage": "https://github.com/chris15joseph/opencode-model-price-intel#readme",
  "bugs": {
    "url": "https://github.com/chris15joseph/opencode-model-price-intel/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "pricing",
    "model-pricing",
    "model-cost",
    "artificial-analysis",
    "intelligence-index",
    "llm",
    "cost"
  ],
  "license": "MIT"
}
