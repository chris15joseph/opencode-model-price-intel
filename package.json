{
  "name": "opencode-model-pricing",
  "version": "1.0.0",
  "description": "OpenCode plugin: list input/output/cache prices and Artificial Analysis Intelligence Index scores per model in /models. Prices come from the live model registry; scores refresh on plugin load and every refreshHours (default 12), with a bundled snapshot fallback.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "types": "./src/index.ts",
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@opencode/plugin": "2.2.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import ./scripts/register-ts.mjs --test test/*.test.ts",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chris15joseph/opencode-model-pricing.git"
  },
  "author": "Christopher Joseph <chrisjoseph15496@gmail.com>",
  "homepage": "https://github.com/chris15joseph/opencode-model-pricing#readme",
  "bugs": {
    "url": "https://github.com/chris15joseph/opencode-model-pricing/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "pricing",
    "model-pricing",
    "artificial-analysis",
    "intelligence-index",
    "llm",
    "cost"
  ],
  "license": "MIT"
}
